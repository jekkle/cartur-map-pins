<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CarturMapPins</AssemblyName>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    <!-- Managed DLLs come from the raw Steam install -->
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>
    <!-- Actual play happens through r2modman's Default profile - deploy the built DLL there -->
    <R2MODMAN_PROFILE Condition="'$(R2MODMAN_PROFILE)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Default</R2MODMAN_PROFILE>
  </PropertyGroup>

  <!-- The probe, the auto-probe and the per-tick counters exist to answer "why isn't this
       being pinned". That is a development question. A Release build drops them: no
       carturpins_probe / _locations / _catalog commands, no AutoProbeOnSpawn option, and
       none of the per-tick Drain / AddInstance lines that made this mod 73% of the log.

       Build Debug to get them back:  dotnet build -c Debug -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Probe.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="HarmonyX" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stays a PNG rather than the raw-RGBA dump the compass mod needed: the sheet is decoded
         via reflection on Texture2D.LoadImage, which avoids referencing the ReadOnlySpan
         overload set at compile time (CS0518 under net472 + this game's netstandard.dll). -->
    <EmbeddedResource Include="Assets\pin_icons.png">
      <LogicalName>CarturMapPins.pin_icons.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Minimap.AddPin's optional `PlatformUserID author` parameter lives here, so the overload
         can't be resolved without it even though we never pass that argument. -->
    <Reference Include="Splatform">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Only for the diagnostic font dump (see Probe.DumpFonts) - the game's TMP font asset
         names can't be read from the compressed tmp_fonts bundle, only enumerated at runtime. -->
    <!-- IMGUI: the icon dropdown draws the sprites itself, and ConfigurationManager
         renders in OnGUI. Nothing else in the mod uses it. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Auto-deploy built DLL into the r2modman profile BepInEx actually loads -->
  <Target Name="DeployToPlugins" AfterTargets="Build">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)$(AssemblyName).dll" />
    </ItemGroup>
    <MakeDir Directories="$(R2MODMAN_PROFILE)\BepInEx\plugins\CarturMapPins" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(R2MODMAN_PROFILE)\BepInEx\plugins\CarturMapPins" />
  </Target>

</Project>
